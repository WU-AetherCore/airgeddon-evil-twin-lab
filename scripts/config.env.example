# ============================================================
# Evil Twin Lab - 环境变量配置模板
# 复制为 config.env 并按你的环境修改，然后 source config.env
# ============================================================

# USB 无线网卡接口名（ip link 查看，如 wlx90de80defb54）
export WIFI_IFACE="wlxYOUR_USB_WIFI_IFACE"

# 项目工作目录（脚本、配置、密码记录都放这里）
export EVIL_BASE_DIR="/opt/evil-twin"

# 控制台 Web 端口（默认 8090）
export EVIL_CTRL_PORT="8090"

# 假 AP 钓鱼网段（默认 10.0.0.1/24，一般不用改）
export EVIL_GATEWAY_IP="10.0.0.1"

# Captive Portal 展示的 SSID（攻击时会动态替换，此值仅作兜底）
export PORTAL_SSID="YOUR_WIFI_SSID"

# 密码验证握手表（可选，多目标用分号分隔）
# 格式: SSID:握手hccapx绝对路径:AP的BSSID
# 例: export EVIL_HASHES="CMCC-gf7e:/opt/evil-twin/handshakes/gf7e.hccapx:C8:75:F4:40:D6:8A"
export EVIL_HASHES=""

# 控制台 API 地址（钓鱼页回调，一般保持默认）
export CTRL_VERIFY_URL="http://127.0.0.1:8090/api/verify"
